# fal.ai — scripts/generate-avatars-fal.mjs (patients 8–17)
#           scripts/generate-devices-fal.mjs (IoT device images)
FAL_KEY=
# FAL_API_KEY=   # alias
# FAL_MODEL=fal-ai/flux/dev

# Cloudflare Pages — cross-browser / cross-device demo sync (build env var)
# Option A: dedicated Worker subdomain (recommended)
# VITE_SYNC_WS_URL=wss://ihomecare-demo-sync.<your-subdomain>.workers.dev
# Option B: same-origin route on your Pages domain (requires Worker route /api/demo-sync)
# VITE_SYNC_WS_URL=/api/demo-sync
